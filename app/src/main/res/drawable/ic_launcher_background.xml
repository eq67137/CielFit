<?xml version="1.0" encoding="utf-8"?>
<!--
  CielFit adaptive icon - BACKGROUND layer. 108x108dp, must be fully opaque.
  Near-black radial wash matching the app background so the icon sits on-theme.
  All legibility lives in the foreground layer.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="78"
                android:startColor="#16161F"
                android:endColor="#07070C" />
        </aapt:attr>
    </path>
</vector>